{"nodes": [{"id": "specs_2026_11_23_revision_ordenes_design_document", "label": "Bit\u00e1cora de revisi\u00f3n de \u00f3rdenes \u2014 dise\u00f1o", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_11_23_revision_ordenes_design_bitacora_administrativa_sin_efectos_financieros", "label": "Bit\u00e1cora administrativa sin efectos financieros", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo escribe RevisionOrden; nunca Orden, Cobro, stock, caja, historial ni mensajes WhatsApp."}, {"id": "specs_2026_11_23_revision_ordenes_design_marcas_vigentes_y_errores_anteriores", "label": "Marcas vigentes y errores anteriores", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desmarcar solo lo cambiado; conservar errores hist\u00f3ricos aunque se vuelva a revisar hasta que admin los quite."}, {"id": "specs_2026_11_23_revision_ordenes_design_revision_completa_por_producto_cobro_y_total", "label": "Revisi\u00f3n completa por producto cobro y total", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marcar revisada requiere todas las respuestas y datos del error; error anotado no impide completar revisi\u00f3n."}, {"id": "specs_2026_11_23_revision_ordenes_design_privacidad_exclusiva_del_administrador", "label": "Privacidad exclusiva del administrador", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anotaciones no se exponen a mesero, digital, cocina ni al resumen de cierre."}, {"id": "specs_2026_11_23_revision_ordenes_design_control_optimista_entre_administradores", "label": "Control optimista entre administradores", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Segundo administrador con versi\u00f3n obsoleta debe recargar; se conserva \u00faltima versi\u00f3n."}, {"id": "specs_2026_11_23_revision_ordenes_design_atribucion_congelada_de_errores", "label": "Atribuci\u00f3n congelada de errores", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md:107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Producto se atribuye al creador; cobro/total al cobrador o creador si no hubo cobrador; conserva persona al anotar."}], "edges": [{"source": "specs_2026_11_23_revision_ordenes_design_document", "target": "specs_2026_11_23_revision_ordenes_design_bitacora_administrativa_sin_efectos_financieros", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-23-revision-ordenes-design.md", "source_location": "docs/superpowers/s