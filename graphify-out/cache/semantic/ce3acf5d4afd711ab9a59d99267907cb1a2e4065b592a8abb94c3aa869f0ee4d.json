{"nodes": [{"id": "whatsapp_agent_readme_document", "label": "Pedidos por WhatsApp: OpenWA y agente", "file_type": "document", "source_file": "whatsapp-agent/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "whatsapp_agent_readme_openwa", "label": "OpenWA como ejecutor de WhatsApp", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El n\u00famero ejecutor recibe pedidos y el POS crea la orden y las salidas en una operaci\u00f3n; el agente entrega mensajes al equipo."}, {"id": "whatsapp_agent_readme_telefonos_internacionales", "label": "Tel\u00e9fonos internacionales de clientes", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ecuador conserva formatos locales y +593. Otros pa\u00edses requieren + y c\u00f3digo, 8\u201315 d\u00edgitos, con separadores admitidos. Solo valida formato, no existencia del n\u00famero ni cuenta WhatsApp."}, {"id": "whatsapp_agent_readme_agente", "label": "Agente de salidas WhatsApp", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consulta el POS peri\u00f3dicamente y reintenta con la misma clave. Un resultado de env\u00edo desconocido pasa a revisi\u00f3n en lugar de reenviar ciegamente."}, {"id": "whatsapp_agent_readme_aviso_moto", "label": "Aviso autom\u00e1tico al grupo Motos", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Al vencer la espera se env\u00eda la solicitud de moto con los datos guardados; la confirmaci\u00f3n marca Delivery pedido."}, {"id": "whatsapp_agent_readme_revision_manual", "label": "Revisi\u00f3n manual de mensajes WhatsApp", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mensajes vencidos, suspendidos, antiguos o de resultado incierto requieren resoluci\u00f3n manual; descartar no env\u00eda mensajes."}, {"id": "whatsapp_agent_readme_respaldo_sesion", "label": "Respaldo de la sesi\u00f3n OpenWA", "file_type": "concept", "source_file": "whatsapp-agent/README.md", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El respaldo conserva acceso al ejecutor; restaurar debe preservar claves de env\u00edo del POS y evitar mensajes duplicados."}], "edges": [{"source": "whatsapp_agent_readme_document", "target": "whatsapp_agent_readme_openwa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "whatsapp-agent/README.md", "source_location": "L15", "weight": 1.0}, {"source": "whatsapp_agent_readme_document", "target": "whatsapp_agent_readme_telefonos_internacionales", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "whatsapp-agent/README.md", "source_location": "L17", "weight": 1.0}, {"source": "whatsapp_agent_readme_document", "target": "whatsapp_agent_readme_agente", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "whatsapp-agent/README.md", "source_location": "L18", "weight": 1.0}, {"source": "whatsapp_agent_readme_document", "target": "whatsapp_agent_readme_aviso_moto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "whatsapp-agent/README.md", "source_location": "L19", "weight": 1.0}, {"source": "whatsapp_agent_readme_document", "target": "whatsapp_agent_readme_revision_manual", "relation": "r